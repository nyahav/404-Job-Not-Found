---
interface Props {
  title: string;
  description: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  wide?: boolean;
  theme?: 'default' | 'alpine';
}

import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';

const {
  title,
  description,
  lang = 'en',
  dir = 'ltr',
  wide = false,
  theme = 'default',
} = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Heebo:wght@400;500;600;700&family=Rubik:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg?v=20261111-2`} />
    <title>{title}</title>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body
    class:list={[
      'min-h-screen bg-base text-primary antialiased',
      theme === 'alpine' && 'alpine-site',
    ]}
  >
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteNavbar basePath={basePath} currentPath={Astro.url.pathname} />
    <main
      class:list={['site-main mx-auto', wide ? 'max-w-none' : 'max-w-5xl px-6 py-16 sm:py-24']}
      id="main-content"
    >
      <slot />
    </main>
    <SiteFooter basePath={basePath} />
  </body>
</html>
