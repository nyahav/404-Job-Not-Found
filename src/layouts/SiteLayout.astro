---
interface Props {
  title: string;
  description: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  aboutLabel?: string;
  articlesLabel?: string;
  wide?: boolean;
  theme?: 'default' | 'alpine';
}

import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteNavbar from '../components/site/SiteNavbar';
import SiteMotion from '../components/site/SiteMotion';

const {
  title,
  description,
  lang = 'en',
  dir = 'ltr',
  aboutLabel = 'About me',
  articlesLabel = 'Articles',
  wide = false,
  theme = 'default',
} = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg?v=20261111-2`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body
    class:list={[
      'min-h-screen bg-base text-primary antialiased',
      theme === 'alpine' && 'alpine-site',
    ]}
  >
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteNavbar
      basePath={basePath}
      currentPath={Astro.url.pathname}
      aboutLabel={aboutLabel}
      articlesLabel={articlesLabel}
      client:load
      transition:persist
    />
    <main
      class:list={['site-main mx-auto', wide ? 'max-w-none' : 'max-w-5xl px-6 py-16 sm:py-24']}
      id="main-content"
      transition:animate="none"
    >
      <slot />
    </main>
    <SiteFooter basePath={basePath} />
    <SiteMotion client:load transition:persist />
  </body>
</html>
