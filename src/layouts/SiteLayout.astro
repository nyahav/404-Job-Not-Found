---
interface Props {
  title: string;
  description: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  aboutLabel?: string;
  articlesLabel?: string;
  wide?: boolean;
}

import '../styles/global.css';

const {
  title,
  description,
  lang = 'en',
  dir = 'ltr',
  aboutLabel = 'About me',
  articlesLabel = 'Articles',
  wide = false,
} = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <header class="border-b border-slate-800">
      <nav class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-6 py-5 sm:flex-row sm:justify-between">
        <a class="font-semibold tracking-tight text-white" href={basePath}>
          404 <span class="text-cyan-400">/</span> Job Not Found
        </a>
        <div class="flex max-w-full flex-wrap items-center justify-center gap-x-4 gap-y-3 sm:justify-end sm:gap-6">
          <a
            class="text-sm text-slate-300 transition hover:text-cyan-300"
            href={`${basePath}about/`}
          >
            {aboutLabel}
          </a>
          <a
            class="text-sm text-slate-300 transition hover:text-cyan-300"
            href={`${basePath}cloud-architect/`}
          >
            Cloud Architect
          </a>
          <a
            class="text-sm text-slate-300 transition hover:text-cyan-300"
            href={`${basePath}database-explorer/`}
          >
            Database Explorer
          </a>
          <a
            class="text-sm text-slate-300 transition hover:text-cyan-300"
            href={`${basePath}#articles`}
          >
            {articlesLabel}
          </a>
          <a
            aria-label="LinkedIn profile"
            class="text-slate-300 transition hover:text-cyan-300"
            href="https://www.linkedin.com/in/nir-yahav/"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg aria-hidden="true" class="size-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z" />
            </svg>
          </a>
          <a
            aria-label="GitHub profile"
            class="text-slate-300 transition hover:text-cyan-300"
            href="https://github.com/nyahav"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg aria-hidden="true" class="size-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.64-1.24-1.64-1.02-.7.08-.69.08-.69 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.62 1.2 3.26.92.1-.72.39-1.2.71-1.48-2.48-.28-5.08-1.24-5.08-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.29-2.61 5.23-5.1 5.51.4.35.76 1.02.76 2.06v3.11c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
            </svg>
          </a>
        </div>
      </nav>
    </header>
    <main class:list={['mx-auto', wide ? 'max-w-none' : 'max-w-5xl px-6 py-16 sm:py-24']}>
      <slot />
    </main>
    <footer class="border-t border-slate-800 px-6 py-8 text-center text-sm text-slate-500">
      {lang === 'he'
        ? 'נבנה עם Astro, React, MDX ו־Tailwind CSS.'
        : 'Built with Astro, React, MDX, and Tailwind CSS.'}
    </footer>
  </body>
</html>
