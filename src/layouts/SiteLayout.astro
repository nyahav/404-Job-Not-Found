---
interface Props {
  title: string;
  description: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  wide?: boolean;
  theme?: 'default' | 'alpine';
  ogType?: 'website' | 'article' | 'profile';
  noIndex?: boolean;
}

import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import JsonLd from '../components/site/JsonLd.astro';
import seceda from '../assets/mountains/seceda.jpg';
import '../styles/global.css';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteNavbar from '../components/site/SiteNavbar.astro';

const {
  title,
  description,
  lang = 'en',
  dir = 'ltr',
  wide = false,
  theme = 'default',
  ogType = 'website',
  noIndex = false,
} = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const siteBase = new URL(basePath, Astro.site);
const routePath = Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length)
  : Astro.url.pathname.replace(/^\/+/, '');
const canonicalUrl = new URL(routePath, siteBase).toString();
const socialImage = await getImage({
  src: seceda,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'webp',
});
const socialImageUrl = new URL(socialImage.src, Astro.site).toString();
const siteUrl = siteBase.toString();
const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: '404 - Job Not Found',
      inLanguage: ['en', 'he'],
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: '404 - Job Not Found',
      url: siteUrl,
      sameAs: ['https://github.com/nyahav'],
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#yahav-nir`,
      name: 'יהב ניר',
      alternateName: 'Yahav Nir',
      jobTitle: 'מהנדס תוכנה',
      description: 'מהנדס תוכנה המתמחה במערכות מבוזרות, שירותי Backend ואמינות מערכות.',
      url: new URL('about/', siteBase).toString(),
      sameAs: ['https://www.linkedin.com/in/nir-yahav/', 'https://github.com/nyahav'],
    },
  ],
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="404 - Job Not Found" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noIndex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Sunrise over Seceda in the Dolomites" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Sunrise over Seceda in the Dolomites" />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    <JsonLd data={websiteSchema} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Heebo:wght@400;500;600;700&family=Rubik:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg?v=20261112-1`} />
    <title>{title}</title>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body
    class:list={[
      'min-h-screen bg-base text-primary antialiased',
      theme === 'alpine' && 'alpine-site',
    ]}
  >
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteNavbar basePath={basePath} currentPath={Astro.url.pathname} />
    <main
      class:list={['site-main mx-auto', wide ? 'max-w-none' : 'max-w-5xl px-6 py-16 sm:py-24']}
      id="main-content"
    >
      <slot />
    </main>
    <SiteFooter basePath={basePath} />
  </body>
</html>
