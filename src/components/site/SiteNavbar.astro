---
interface Props {
  basePath: string;
  currentPath: string;
}

const { basePath, currentPath } = Astro.props;
const normalizedBasePath = basePath.endsWith('/') ? basePath : `${basePath}/`;
const links = [
  { href: normalizedBasePath, label: 'Home', path: normalizedBasePath },
  { href: `${normalizedBasePath}about/`, label: 'About Me', path: `${normalizedBasePath}about/` },
  {
    href: `${normalizedBasePath}cloud-architect/`,
    label: 'Cloud Architect',
    path: `${normalizedBasePath}cloud-architect/`,
  },
  {
    href: `${normalizedBasePath}database-explorer/`,
    label: 'Database Explorer',
    path: `${normalizedBasePath}database-explorer/`,
  },
  {
    href: `${normalizedBasePath}3-am/`,
    label: '3AM Incident Lab',
    path: `${normalizedBasePath}3-am/`,
  },
  {
    href: `${normalizedBasePath}#articles`,
    label: 'Articles',
    path: `${normalizedBasePath}#articles`,
  },
];

const normalizedCurrentPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const isCurrent = (path: string) => {
  const [destination, hash] = path.split('#');
  if (hash) return false;
  return (
    normalizedCurrentPath === destination ||
    (destination !== normalizedBasePath && normalizedCurrentPath.startsWith(destination))
  );
};
---

<header class="site-header" data-base-path={normalizedBasePath} data-scrolled="false">
  <nav aria-label="Main navigation" class="site-nav">
    <a aria-label="404 Job Not Found home" class="site-brand" href={normalizedBasePath}>
      <span aria-hidden="true" class="site-brand__bubble"></span>
      <span class="site-brand__mark">404</span>
      <span aria-hidden="true" class="site-brand__divider">
        /
      </span>
      <span>Job Not Found</span>
    </a>

    <div class="site-nav__links">
      {links.map((link) => (
        <a
          aria-current={isCurrent(link.path) ? 'page' : undefined}
          class="site-nav__link"
          data-nav-path={link.path}
          href={link.href}
        >
          {link.label}
        </a>
      ))}
      <a
        aria-label="LinkedIn profile (opens in a new tab)"
        class="site-nav__social"
        href="https://www.linkedin.com/in/nir-yahav/"
        rel="noopener noreferrer"
        target="_blank"
      >
        <svg aria-hidden="true" class="site-nav__social-icon" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2ZM8.34 18H5.67V9.4h2.67ZM7 8.23a1.55 1.55 0 1 1 0-3.1 1.55 1.55 0 0 1 0 3.1ZM18.34 18h-2.67v-4.19c0-1-.02-2.29-1.4-2.29s-1.62 1.1-1.62 2.22V18H9.98V9.4h2.56v1.17h.04a2.8 2.8 0 0 1 2.51-1.38c2.69 0 3.19 1.77 3.19 4.07Z"
          />
        </svg>
      </a>
      <a
        aria-label="GitHub profile (opens in a new tab)"
        class="site-nav__social"
        href="https://github.com/nyahav"
        rel="noopener noreferrer"
        target="_blank"
      >
        <svg aria-hidden="true" class="site-nav__social-icon" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.68-3.76-1.32-3.76-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.72 1.15 1.72 1.15.99 1.7 2.59 1.21 3.22.93.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.15a10.58 10.58 0 0 1 5.55 0c2.12-1.45 3.05-1.15 3.05-1.15.61 1.53.23 2.67.11 2.95.72.78 1.15 1.78 1.15 3 0 4.3-2.61 5.24-5.1 5.52.4.35.75 1.03.75 2.08v3.08c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"
          />
        </svg>
      </a>
    </div>

    <button
      aria-controls="mobile-site-menu"
      aria-expanded="false"
      aria-label="Open navigation menu"
      class="site-nav__toggle"
      data-nav-toggle
      type="button"
    >
      <svg
        aria-hidden="true"
        class="site-nav__icon site-nav__icon--menu"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="1.8"
        />
      </svg>
      <svg
        aria-hidden="true"
        class="site-nav__icon site-nav__icon--close"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          d="m6 6 12 12M18 6 6 18"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="1.8"
        />
      </svg>
    </button>

    <div class="site-nav__mobile" data-mobile-menu hidden id="mobile-site-menu">
      {links.map((link) => (
        <a
          aria-current={isCurrent(link.path) ? 'page' : undefined}
          class="site-nav__mobile-link"
          data-nav-path={link.path}
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const initializeNavbar = () => {
    document.querySelectorAll<HTMLElement>('.site-header').forEach((header) => {
      if (header.dataset.navInitialized === 'true') return;
      header.dataset.navInitialized = 'true';

      const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
      const brand = header.querySelector<HTMLAnchorElement>('.site-brand');
      if (!toggle || !menu) return;

      const closeMenu = () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
        menu.hidden = true;
      };

      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        toggle.setAttribute(
          'aria-label',
          isOpen ? 'Open navigation menu' : 'Close navigation menu',
        );
        menu.hidden = isOpen;
      });

      if (brand && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        brand.addEventListener(
          'pointermove',
          (event) => {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const bounds = brand.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - 0.5;
            const y = (event.clientY - bounds.top) / bounds.height - 0.5;
            brand.style.setProperty('--brand-orb-x', `${x * 10}px`);
            brand.style.setProperty('--brand-orb-y', `${y * 8}px`);
            brand.style.setProperty('--brand-shift-x', `${x * 1.5}px`);
            brand.style.setProperty('--brand-shift-y', `${y * 1.5}px`);
          },
          { passive: true },
        );
        brand.addEventListener('pointerleave', () => {
          brand.style.removeProperty('--brand-orb-x');
          brand.style.removeProperty('--brand-orb-y');
          brand.style.removeProperty('--brand-shift-x');
          brand.style.removeProperty('--brand-shift-y');
        });
      }

      menu.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) closeMenu();
      });

      header.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMenu();
          toggle.focus();
        }
      });

      const updateNavigation = () => {
        header.querySelectorAll<HTMLAnchorElement>('[data-nav-path]').forEach((link) => {
          const target = link.dataset.navPath;
          const current = window.location.pathname.endsWith('/')
            ? window.location.pathname
            : `${window.location.pathname}/`;
          if (!target) return;
          const [targetPath, targetHash] = target.split('#');
          const base = header.dataset.basePath;
          const active = targetHash
            ? current === targetPath && window.location.hash === `#${targetHash}`
            : current === targetPath || (targetPath !== base && current.startsWith(targetPath));
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
        closeMenu();
      };

      const updateScrolledState = () => {
        header.dataset.scrolled = String(window.scrollY > 16);
      };

      document.addEventListener('astro:page-load', updateNavigation);
      window.addEventListener('scroll', updateScrolledState, { passive: true });
      updateScrolledState();
    });
  };

  document.addEventListener('astro:page-load', initializeNavbar);
  initializeNavbar();
</script>
