---
import { getCollection, render } from 'astro:content';
import JsonLd from '../../components/site/JsonLd.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);

  return Promise.all(
    articles.map(async (article) => {
      const { Content } = await render(article);
      return {
        params: { slug: article.id.replace(/\.(md|mdx)$/, '') },
        props: { article, Content },
      };
    }),
  );
}

const { article, Content } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const slug = article.id.replace(/\.(md|mdx)$/, '');
const siteBase = new URL(basePath, Astro.site);
const canonicalUrl = new URL(`articles/${slug}/`, siteBase).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': article.data.contentType,
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  dateModified: article.data.updatedDate.toISOString(),
  inLanguage: 'he',
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  author: {
    '@type': 'Person',
    name: article.data.author,
    description: article.data.authorBio,
    url: new URL('about/', siteBase).toString(),
    '@id': `${siteBase.toString()}#yahav-nir`,
  },
  publisher: {
    '@type': 'Organization',
    name: '404 - Job Not Found',
    url: siteBase.toString(),
    '@id': `${siteBase.toString()}#organization`,
  },
  isPartOf: { '@id': `${siteBase.toString()}#website` },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'בית',
      item: siteBase.toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'מאמרים',
      item: new URL('articles/', siteBase).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.data.title,
      item: canonicalUrl,
    },
  ],
};
---

<SiteLayout
  title={article.data.title}
  description={article.data.description}
  lang="he"
  dir="rtl"
  wide
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={article.data.pubDate.toISOString()} />
    <meta property="article:modified_time" content={article.data.updatedDate.toISOString()} />
    <meta property="article:author" content={article.data.author} />
    {article.data.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <JsonLd data={articleSchema} />
    <JsonLd data={breadcrumbSchema} />
  </Fragment>
  <article class="article-reading" dir="rtl">
    <a class="article-reading__back" href={`${basePath}articles/`}>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="m15 18-6-6 6-6" />
      </svg>
      לכל המאמרים
    </a>
    <header class="article-reading__header" style={`view-transition-name: article-card-${slug}`}>
      <p class="article-reading__date">
        פורסם ב־
        <time datetime={article.data.pubDate.toISOString()} dir="ltr">
          {article.data.pubDate.toLocaleDateString('he-IL', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {' · '}
        עודכן ב־
        <time datetime={article.data.updatedDate.toISOString()} dir="ltr">
          {article.data.updatedDate.toLocaleDateString('he-IL', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </p>
      <h1>{article.data.title}</h1>
      <p class="article-reading__description">{article.data.description}</p>
    </header>
    <div class="article-reading__content">
      <Content />
    </div>
    <footer class="article-reading__author">
      <h2>על הכותב</h2>
      <p>
        <strong>{article.data.author}</strong> — {article.data.authorBio}
      </p>
      <a href={`${basePath}about/`}>מידע נוסף על יהב ניר</a>
    </footer>
  </article>
</SiteLayout>
