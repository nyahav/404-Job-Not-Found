---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import seceda from '../assets/mountains/seceda.jpg';
import mountainClouds from '../assets/mountains/mountain-clouds.jpg';
import mountainTrail from '../assets/mountains/mountain-trail.jpg';
import { buildRidge, type RidgeOptions } from '../utils/ridges';

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const experience = [
  {
    role: 'מהנדס תוכנה',
    company: 'PTBox',
    period: 'יוני 2025 – היום',
    highlights: [
      'תכנון שירות תזמור מרכזי שהגדיל את תפוקת הכלים פי 3 והפחית את זמן התזמון מ־200 ל־5 מילישניות, באמצעות מתזמן משוקלל ומטמון בזיכרון.',
      'הפחתת קריסות OOM של קונטיינרים בכ־90% באמצעות בקרת קבלה היברידית, תעדוף משימות ומנגנון התאוששות מבוסס Docker.',
      'הובלת מעבר ממערכת SQL ותיקה לארכיטקטורת SQL/NoSQL היברידית, ושילוב אימות משתמשים אחוד מבוסס Keycloak בשירותי Python ו־Kotlin.',
    ],
  },
  {
    role: 'מהנדס תמיכה',
    company: 'Base44',
    period: 'פברואר 2025 – יוני 2025',
    highlights: [
      'אבחון תקלות API ואינטגרציה ב־React וב־JavaScript, איתור גורמי שורש והעברת ממצאים הניתנים לשחזור.',
    ],
  },
  {
    role: 'אנליסט נתונים',
    company: 'HR Signal',
    period: 'יוני 2024 – פברואר 2025',
    highlights: [
      'ניתוח נתונים ב־BigQuery ובניית אוטומציות סטטיסטיות ב־Python, שהפחיתו ב־15% את עבודת הדיווח הידנית החוזרת.',
    ],
  },
  {
    role: 'מהנדס NOC',
    company: 'Check Point Software',
    period: 'דצמבר 2022 – פברואר 2024',
    highlights: ['פתרון תקלות Linux ורשתות ושיפור תהליך ההטמעה, שקיצר את זמן האינטגרציה ב־30%.'],
  },
];

const skillGroups = [
  {
    number: '01',
    title: 'שפות ופיתוח',
    skills: 'Python, FastAPI, Java, Kotlin, JavaScript, TypeScript, React',
  },
  {
    number: '02',
    title: 'תשתיות וענן',
    skills: 'Docker, Kubernetes, RabbitMQ, AWS, GCP, Helm, Terraform, GitHub Actions',
  },
  {
    number: '03',
    title: 'מערכות ונתונים',
    skills: 'מערכות מבוזרות, תכנון API, PostgreSQL, MySQL, MongoDB, BigQuery',
  },
];

// ── Alpine skyline: 5 procedurally generated ridges (back → front) ──────────
// Each layer fades from its crest colour into atmospheric haze at its base,
// so ranges dissolve into one another like the reference photo.
type RidgeLayer = RidgeOptions & {
  id: string;
  depth: number; // parallax strength: back = small, front = large
  drift?: 'slow' | 'medium' | 'fast';
  crest: string;
  haze: string;
  hold?: number; // fraction of the gradient that stays at the crest colour
  mistAfter?: boolean; // add a drifting mist band in front of this layer
};

const ridgeLayers: RidgeLayer[] = [
  {
    id: 'sage',
    depth: 0.18,
    drift: 'slow',
    crest: '#a9b8a3',
    haze: '#dbe2d3',
    seed: 11,
    base: 372,
    amp: 250,
    peaks: 5,
    sharp: 1.05,
    crag: 0.07,
    rough: 10,
  },
  {
    id: 'blue',
    depth: 0.34,
    drift: 'medium',
    crest: '#8b9fa3',
    haze: '#cbd6d0',
    seed: 47,
    base: 392,
    amp: 215,
    peaks: 6,
    sharp: 1.15,
    crag: 0.06,
    rough: 9,
    mistAfter: true,
  },
  {
    id: 'forest',
    depth: 0.55,
    crest: '#5f7d6c',
    haze: '#a9bcae',
    seed: 23,
    base: 418,
    amp: 175,
    peaks: 6,
    sharp: 1.3,
    crag: 0.045,
    rough: 7,
    mistAfter: true,
  },
  {
    id: 'pine',
    depth: 0.78,
    drift: 'fast',
    crest: '#3a5649',
    haze: '#7e9889',
    seed: 91,
    base: 440,
    amp: 120,
    peaks: 7,
    sharp: 1.9,
    crag: 0.02,
    rough: 4,
    trees: { w: 4, h: 11, gap: 0.7 },
  },
  {
    id: 'night',
    depth: 1,
    crest: '#16271f',
    haze: '#f5f2e9',
    hold: 0.9,
    seed: 5,
    base: 448,
    amp: 38,
    peaks: 4,
    sharp: 1.6,
    crag: 0.01,
    rough: 2,
    trees: { w: 9, h: 70, gap: 1.5, edgeBoost: true },
  },
];
const ridges = ridgeLayers.map((layer) => ({ ...layer, ...buildRidge(layer) }));

const sections = [
  { id: 'intro', label: 'ראשי', index: '01' },
  { id: 'about', label: 'עליי', index: '02' },
  { id: 'journey', label: 'ניסיון', index: '03' },
  { id: 'toolkit', label: 'טכנולוגיות', index: '04' },
  { id: 'project', label: 'פרויקט', index: '05' },
  { id: 'education', label: 'השכלה ושירות', index: '06' },
];
---

<SiteLayout
  title="אודות | יהב ניר"
  description="מהנדס תוכנה המתמחה במערכות מבוזרות, שירותי Backend ואמינות מערכות."
  lang="he"
  dir="rtl"
  aboutLabel="עליי"
  articlesLabel="מאמרים"
  wide
  theme="alpine"
>
  <div class="alpine-page">
    <div aria-hidden="true" class="about-progress"></div>

    <nav aria-label="ניווט בעמוד" class="about-rail">
      <div class="about-rail__links">
        {sections.map((section) => (
          <a
            aria-label={section.label}
            class="about-rail__link"
            href={`#${section.id}`}
            data-section-link={section.id}
          >
            <span class="about-rail__number">{section.index}</span>
            <span class="about-rail__label">{section.label}</span>
          </a>
        ))}
      </div>
    </nav>

    <section
      aria-labelledby="about-hero-title"
      class="about-hero"
      data-about-section="intro"
      id="intro"
    >
      <Image
        alt="רכס הרי הדולומיטים בסקדה בשעת זריחה, עם עננים דרמטיים מעל העמק"
        class="about-hero__image"
        src={seceda}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
      />
      <div aria-hidden="true" class="about-hero__shade"></div>
      <div class="about-hero__content">
        <p class="eyebrow eyebrow--light">
          <span>01</span> · נעים להכיר
        </p>
        <h1 id="about-hero-title">
          יהב ניר<span class="hero-period">.</span>
        </h1>
        <p class="about-hero__role">מהנדס תוכנה, בונה מערכות שאפשר לסמוך עליהן.</p>
        <p class="about-hero__intro">
          אני מתכנן ומפתח שירותי Backend ומערכות מבוזרות — עם אהבה לביצועים, לאמינות, ולפרטים הקטנים
          שעושים מערכת טובה למערכת מצוינת.
        </p>
        <div class="about-hero__actions">
          <a class="button button--light" href="#journey">
            המסע המקצועי <span aria-hidden="true">←</span>
          </a>
          <a
            class="button button--outline"
            href={`${basePath}Yahav-Nir-Resume.pdf`}
            download="Yahav-Nir-Resume.pdf"
          >
            קורות חיים <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <div class="about-hero__caption" dir="ltr">
        <span>SECEDA · DOLOMITES</span>
        <span>46°35′ N — 11°43′ E</span>
      </div>
      <a aria-label="גלילה לתוכן" class="scroll-cue" href="#about">
        <span>לגלול ולגלות</span>
        <span aria-hidden="true" class="scroll-cue__line"></span>
      </a>
    </section>

    <section aria-hidden="true" class="mountain-horizon" data-mountain-horizon>
      <div class="mountain-horizon__sun"></div>
      {ridges.map((ridge, index) => (
        <>
          <div class="ridge" style={`--depth:${ridge.depth};--i:${index}`}>
            <svg
              class:list={['ridge__svg', ridge.drift && `ridge__svg--${ridge.drift}`]}
              focusable="false"
              preserveAspectRatio="xMidYMax slice"
              viewBox="0 0 1600 480"
            >
              <defs>
                <linearGradient
                  gradientUnits="userSpaceOnUse"
                  id={`ridge-fill-${ridge.id}`}
                  x1="0"
                  x2="0"
                  y1={Math.round(ridge.minY)}
                  y2="480"
                >
                  <stop offset="0" stop-color={ridge.crest} />
                  <stop offset={ridge.hold ?? 0.5} stop-color={ridge.crest} />
                  <stop offset="1" stop-color={ridge.haze} />
                </linearGradient>
              </defs>
              <path d={ridge.d} fill={`url(#ridge-fill-${ridge.id})`} />
            </svg>
          </div>
          {ridge.mistAfter && <div class={`mist mist--${index % 2 ? 'a' : 'b'}`} />}
        </>
      ))}
      <div class="mountain-horizon__fade"></div>
      <div class="mountain-horizon__caption" dir="ltr">
        <span>DOLOMITES · 2,519 M</span>
        <span>ABOVE THE NOISE</span>
      </div>
    </section>

    <section
      aria-labelledby="about-story-title"
      class="story-section section-light"
      data-about-section="about"
      id="about"
    >
      <div class="section-shell story-grid">
        <div class="story-copy reveal">
          <p class="eyebrow">
            <span>02</span> · קצת עליי
          </p>
          <h2 class="display-title" id="about-story-title">
            בהירות נבנית
            <br />
            <em>מהדברים הקטנים.</em>
          </h2>
          <p class="story-lead">
            אני מהנדס תוכנה עם ניסיון בבניית שירותי Backend, שיפור אמינות מערכות ועבודה עם מערכות
            מבוזרות.
          </p>
          <p class="body-copy">
            אני נהנה לפתור בעיות מורכבות, לשפר ביצועים ולבנות שירותים יציבים שאפשר לסמוך עליהם.
            בעיניי, הנדסה טובה מחברת בין חשיבה מערכתית, סקרנות, ויכולת להפוך את המורכב לפשוט.
          </p>
          <a class="text-link" href="mailto:yahavnirr@gmail.com" dir="ltr">
            yahavnirr@gmail.com <span aria-hidden="true">↗</span>
          </a>
        </div>
        <figure class="story-photo reveal">
          <div class="photo-frame">
            <Image
              alt="שביל הררי המתפתל בין רכסי הדולומיטים הירוקים"
              class="photo-image"
              src={mountainTrail}
              widths={[480, 720, 960]}
              sizes="(max-width: 760px) 100vw, 46vw"
              format="webp"
              quality={78}
              loading="lazy"
            />
            <span aria-hidden="true" class="photo-index">
              46° / 11°
            </span>
          </div>
          <figcaption>דרך טובה מתחילה בצעד אחד, ונבנית צעד אחרי צעד.</figcaption>
        </figure>
      </div>
    </section>

    <section
      aria-labelledby="journey-title"
      class="journey-section"
      data-about-section="journey"
      id="journey"
    >
      <div class="section-shell">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow eyebrow--light">
              <span>03</span> · ניסיון
            </p>
            <h2 class="display-title display-title--light" id="journey-title">
              המסע <em>המקצועי.</em>
            </h2>
          </div>
          <p class="section-aside">תחנות, אתגרים, ומערכות שהפכו יציבות יותר בדרך.</p>
        </div>

        <div class="timeline">
          {experience.map((job, index) => (
            <article class="timeline-item reveal">
              <div class="timeline-marker" aria-hidden="true">
                <span>{String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="timeline-card">
                <div class="timeline-card__heading">
                  <div>
                    <p class="timeline-company" dir="ltr">
                      {job.company}
                    </p>
                    <h3>{job.role}</h3>
                  </div>
                  <p class="timeline-period">{job.period}</p>
                </div>
                <ul class="achievement-list">
                  {job.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      aria-labelledby="toolkit-title"
      class="toolkit-section section-stone"
      data-about-section="toolkit"
      id="toolkit"
    >
      <div class="section-shell">
        <div class="section-heading section-heading--dark reveal">
          <div>
            <p class="eyebrow">
              <span>04</span> · ארגז כלים
            </p>
            <h2 class="display-title" id="toolkit-title">
              הכלים הם <em>רק ההתחלה.</em>
            </h2>
          </div>
          <p class="section-aside">
            טכנולוגיות ותחומי התמחות שאני משתמש בהם כדי לפתור בעיות אמיתיות.
          </p>
        </div>

        <div class="skill-grid">
          {skillGroups.map((group) => (
            <article class="skill-card reveal">
              <span class="skill-number">{group.number}</span>
              <h3>{group.title}</h3>
              <p dir={group.number === '03' ? 'rtl' : 'ltr'}>{group.skills}</p>
              <span aria-hidden="true" class="skill-card__arrow">
                ↗
              </span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      aria-labelledby="project-title"
      class="project-section"
      data-about-section="project"
      id="project"
    >
      <div class="section-shell project-grid">
        <div class="project-copy reveal">
          <p class="eyebrow eyebrow--light">
            <span>05</span> · פרויקט נבחר
          </p>
          <h2 class="display-title display-title--light" id="project-title">
            תמיכה חכמה.
            <br />
            <em>עם אדם בלולאה.</em>
          </h2>
          <p class="project-name">פלטפורמת תמיכת לקוחות מבוססת AI</p>
          <p class="body-copy body-copy--light">
            בניית תהליך עבודה מרובה סוכנים עם LangGraph,‏ FastAPI ו־Amazon Bedrock, הכולל RAG מודע
            להקשר, ניתוח סנטימנט, ניתוב לפי רמת ביטחון והעברה לאיש צוות בעת הצורך באמצעות SageMaker
            A2I. הפרויקט כולל גם פריסה מקומית ב־Kubernetes, ניטור ב־Prometheus וב־Grafana ותשתית AWS
            EKS המנוהלת באמצעות Terraform.
          </p>
          <div aria-label="טכנולוגיות הפרויקט" class="project-tags" dir="ltr">
            <span>LangGraph</span>
            <span>FastAPI</span>
            <span>Amazon Bedrock</span>
            <span>Kubernetes</span>
            <span>Terraform</span>
          </div>
        </div>
        <div aria-hidden="true" class="project-art reveal">
          <div class="project-art__orbit project-art__orbit--outer"></div>
          <div class="project-art__orbit project-art__orbit--inner"></div>
          <div class="project-node project-node--center">AI</div>
          <div class="project-node project-node--one">RAG</div>
          <div class="project-node project-node--two">A2I</div>
          <div class="project-node project-node--three">API</div>
          <span class="project-art__caption">HUMAN-CENTERED SYSTEMS</span>
        </div>
      </div>
    </section>

    <section
      aria-labelledby="education-title"
      class="closing-section section-light"
      data-about-section="education"
      id="education"
    >
      <div class="closing-photo">
        <Image
          alt="פסגת הרים עטופה בעננים ויער כהה למרגלותיה"
          class="closing-photo__image"
          src={mountainClouds}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          format="webp"
          quality={78}
          loading="lazy"
        />
        <div aria-hidden="true" class="closing-photo__shade"></div>
        <p>הדרך חשובה לא פחות מהפסגה.</p>
      </div>
      <div class="section-shell">
        <div class="section-heading section-heading--dark reveal">
          <div>
            <p class="eyebrow">
              <span>06</span> · נקודת מוצא
            </p>
            <h2 class="display-title" id="education-title">
              יסודות <em>להמשך הדרך.</em>
            </h2>
          </div>
          <p class="section-aside">סקרנות, למידה, ועבודת צוות — בכל תחנה.</p>
        </div>

        <div class="foundation-grid">
          <article class="foundation-card reveal">
            <p class="eyebrow">השכלה</p>
            <h3>תואר ראשון במדעי המחשב</h3>
            <p>האוניברסיטה הפתוחה · 2020–2024</p>
          </article>
          <article class="foundation-card reveal">
            <p class="eyebrow">שירות צבאי</p>
            <h3>לוחם וחובש קרבי</h3>
            <p>פלס״ר 7. הכשרת חיילים למצבי לחץ ופיתוח עבודת צוות, אחריות ויכולת הסתגלות.</p>
          </article>
        </div>

        <footer class="about-contact reveal">
          <div>
            <p class="eyebrow">נשאר משהו לבנות.</p>
            <h2>נדבר?</h2>
          </div>
          <div class="contact-actions">
            <a class="button button--forest" href="mailto:yahavnirr@gmail.com" dir="ltr">
              yahavnirr@gmail.com <span aria-hidden="true">↗</span>
            </a>
            <a
              class="button button--line"
              href="https://www.linkedin.com/in/nir-yahav/"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          </div>
        </footer>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  :global(body.alpine-site) {
    background: #f5f2e9;
    color: #23352d;
    font-family: Arial, 'Noto Sans Hebrew', 'Segoe UI', sans-serif;
  }

  :global(body.alpine-site > header) {
    position: relative;
    z-index: 20;
    border-color: rgb(245 242 233 / 12%);
    background: #14251f;
  }

  :global(body.alpine-site > header a) {
    color: #f5f2e9;
  }

  :global(body.alpine-site > header a:hover) {
    color: #c9d2c3;
  }

  :global(body.alpine-site > main) {
    padding: 0;
  }

  .alpine-page {
    --forest: #14251f;
    --pine: #344c43;
    --sage: #9ead9c;
    --stone: #d9d4c7;
    --snow: #f5f2e9;
    --ink: #23352d;
    --muted: #657269;
    overflow: clip;
    background: var(--snow);
    color: var(--ink);
    text-align: right;
  }

  .about-progress {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    height: 3px;
    transform: scaleX(var(--about-progress, 0));
    transform-origin: right;
    background: #b7c8a9;
    pointer-events: none;
  }

  .about-rail {
    position: fixed;
    z-index: 40;
    top: 50%;
    left: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.35rem;
    transform: translateY(-50%);
    color: var(--snow);
    mix-blend-mode: difference;
  }

  .about-rail__links {
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
  }

  .about-rail__link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
    opacity: 0.66;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .about-rail__link:hover,
  .about-rail__link[aria-current='location'] {
    opacity: 1;
  }

  .about-rail__number {
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border: 1px solid rgb(245 242 233 / 45%);
    border-radius: 50%;
    font: 0.55rem/1 monospace;
  }

  .about-rail__link[aria-current='location'] .about-rail__number {
    border-color: #b7c8a9;
    background: #b7c8a9;
    color: var(--forest);
  }

  .about-rail__label {
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .about-hero {
    position: relative;
    display: flex;
    min-height: min(840px, calc(100svh - 72px));
    min-height: max(680px, calc(100svh - 72px));
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    background: var(--forest);
    color: var(--snow);
  }

  .about-hero__image,
  .closing-photo__image {
    position: absolute;
    inset: -4% 0;
    width: 100%;
    height: 108%;
    object-fit: cover;
  }

  .about-hero__image {
    z-index: -2;
    object-position: center 54%;
    transform: translate3d(0, var(--hero-parallax, 0px), 0) scale(1.05);
    will-change: transform;
  }

  .about-hero__shade {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(270deg, rgb(15 29 24 / 88%) 0%, rgb(15 29 24 / 69%) 38%, transparent 100%),
      linear-gradient(0deg, rgb(15 29 24 / 56%), transparent 25%, rgb(15 29 24 / 12%));
  }

  .about-hero__content {
    width: min(100% - 3rem, 1200px);
    margin-inline: auto;
    padding: 5rem 6rem 7rem 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    color: var(--pine);
    font-family: monospace;
    font-size: 0.68rem;
    letter-spacing: 0.11em;
  }

  .eyebrow span {
    color: #71866f;
  }

  .eyebrow--light {
    color: #e0e5d9;
  }

  .eyebrow--light span {
    color: #c2d0b3;
  }

  .about-hero h1 {
    margin: 1.4rem 0 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(4.5rem, 11vw, 9.5rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.94;
  }

  .hero-period {
    color: #c1cca9;
  }

  .about-hero__role {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: #e4e6dc;
    font-size: clamp(1.1rem, 2.1vw, 1.65rem);
    line-height: 1.6;
  }

  .about-hero__intro {
    max-width: 36rem;
    margin: 1rem 0 0;
    color: rgb(245 242 233 / 76%);
    font-size: 1rem;
    line-height: 1.95;
  }

  .about-hero__actions,
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.7rem 1.15rem;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button--light {
    background: var(--snow);
    color: var(--forest);
  }

  .button--light:hover {
    background: #fff;
  }

  .button--outline {
    border-color: rgb(245 242 233 / 52%);
    color: var(--snow);
  }

  .button--outline:hover {
    border-color: var(--snow);
    background: rgb(245 242 233 / 8%);
  }

  .about-hero__caption {
    position: absolute;
    right: max(2rem, calc((100vw - 1200px) / 2));
    bottom: 1.65rem;
    left: max(2rem, calc((100vw - 1200px) / 2));
    display: flex;
    justify-content: space-between;
    color: rgb(245 242 233 / 65%);
    font: 0.58rem/1 monospace;
    letter-spacing: 0.13em;
  }

  .scroll-cue {
    position: absolute;
    right: 50%;
    bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--snow);
    font-size: 0.68rem;
    text-decoration: none;
    transform: translateX(50%);
  }

  .scroll-cue__line {
    width: 2rem;
    height: 1px;
    background: currentColor;
    animation: breathe 1.8s ease-in-out infinite;
  }

  .mountain-horizon {
    --p: 0;
    --parallax-range: 56px;
    position: relative;
    height: clamp(300px, 40vw, 580px);
    margin-top: -1px;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(
      180deg,
      #14251f 0%,
      #2e4339 4%,
      #7e9387 12%,
      #cfd8cb 26%,
      #e6eadf 55%,
      var(--snow) 100%
    );
  }

  .mountain-horizon__sun {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 34% 40% at 72% 34%, rgb(255 251 238 / 62%), transparent 70%),
      radial-gradient(ellipse 50% 45% at 22% 55%, rgb(224 232 222 / 50%), transparent 70%);
  }

  .ridge {
    position: absolute;
    inset: 0;
    transform: translate3d(0, calc(var(--p) * var(--depth) * var(--parallax-range) * -1), 0);
    will-change: transform;
  }

  .ridge__svg {
    position: absolute;
    bottom: 0;
    left: -6%;
    width: 112%;
    height: 100%;
    overflow: visible;
    animation-play-state: paused;
  }

  .ridge__svg--slow {
    animation: mh-drift 42s ease-in-out infinite alternate;
  }

  .ridge__svg--medium {
    animation: mh-drift 32s ease-in-out infinite alternate-reverse;
  }

  .ridge__svg--fast {
    animation: mh-drift 26s ease-in-out infinite alternate;
  }

  .mountain-horizon.is-inview .ridge__svg,
  .mountain-horizon.is-inview .mist {
    animation-play-state: running;
  }

  .mist {
    position: absolute;
    left: -20%;
    width: 140%;
    height: 36%;
    pointer-events: none;
    background:
      radial-gradient(ellipse 38% 50% at 30% 50%, rgb(245 242 233 / 55%), transparent 70%),
      radial-gradient(ellipse 34% 46% at 74% 58%, rgb(245 242 233 / 42%), transparent 70%);
    animation: mh-mist 48s ease-in-out infinite alternate paused;
  }

  .mist--a {
    bottom: 34%;
  }

  .mist--b {
    bottom: 15%;
    animation-direction: alternate-reverse;
  }

  .mountain-horizon__fade {
    position: absolute;
    z-index: 20;
    inset: auto 0 0;
    height: 16%;
    background: linear-gradient(180deg, transparent, var(--snow) 90%);
    pointer-events: none;
  }

  .js .ridge,
  .js .mist {
    opacity: 0;
    translate: 0 34px;
    transition:
      opacity 1100ms ease,
      translate 1500ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 110ms);
  }

  .js .mountain-horizon.is-visible .ridge,
  .js .mountain-horizon.is-visible .mist {
    opacity: 1;
    translate: 0 0;
  }

  .mountain-horizon__caption {
    position: absolute;
    z-index: 30;
    right: max(1.25rem, calc((100vw - 1200px) / 2));
    bottom: 1rem;
    left: max(1.25rem, calc((100vw - 1200px) / 2));
    display: flex;
    justify-content: space-between;
    color: #53665b;
    font: 0.58rem/1 monospace;
    letter-spacing: 0.13em;
  }

  .section-shell {
    width: min(100% - 3rem, 1120px);
    margin-inline: auto;
  }

  .section-light {
    background: var(--snow);
  }

  .section-stone {
    background: var(--stone);
  }

  .story-section,
  .toolkit-section {
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 8rem);
  }

  .display-title {
    margin: 1.15rem 0 0;
    color: var(--forest);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.7rem, 5.3vw, 5.3rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .display-title em {
    color: #71836e;
    font-weight: 400;
  }

  .story-lead {
    margin: 2rem 0 0;
    color: var(--pine);
    font-size: 1.17rem;
    font-weight: 600;
    line-height: 1.9;
  }

  .body-copy {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 2;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.6rem;
    color: var(--pine);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration-color: #aab4a2;
    text-underline-offset: 0.35rem;
  }

  .story-photo {
    margin: 0;
  }

  .photo-frame {
    position: relative;
    min-height: 440px;
    overflow: hidden;
    background: #c3c8bd;
  }

  .photo-image {
    width: 100%;
    height: 500px;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .story-photo:hover .photo-image {
    transform: scale(1.035);
  }

  .photo-index {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.45rem 0.6rem;
    background: rgb(20 37 31 / 78%);
    color: var(--snow);
    font: 0.62rem/1 monospace;
  }

  .story-photo figcaption {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .journey-section,
  .project-section {
    padding-block: clamp(5rem, 9vw, 8.5rem);
    background: var(--forest);
    color: var(--snow);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .section-heading--dark .display-title {
    color: var(--forest);
  }

  .display-title--light {
    color: var(--snow);
  }

  .display-title--light em {
    color: #b9c8ac;
  }

  .section-aside {
    max-width: 18rem;
    margin: 0 0 0.3rem;
    color: #aeb8aa;
    font-size: 0.92rem;
    line-height: 1.8;
  }

  .section-heading--dark .section-aside {
    color: var(--muted);
  }

  .timeline {
    position: relative;
    display: grid;
    gap: 1.35rem;
  }

  .timeline::before {
    position: absolute;
    top: 0.25rem;
    right: 1.35rem;
    bottom: 0.25rem;
    width: 1px;
    background: rgb(217 212 199 / 25%);
    content: '';
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 2.8rem minmax(0, 1fr);
    gap: 1.25rem;
  }

  .timeline-marker {
    z-index: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(185 200 172 / 60%);
    border-radius: 50%;
    background: var(--forest);
    color: #c8d4bc;
    font: 0.66rem/1 monospace;
  }

  .timeline-card {
    padding: 1.45rem 1.6rem 1.55rem;
    border: 1px solid rgb(245 242 233 / 12%);
    background: rgb(245 242 233 / 4%);
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease;
  }

  .timeline-card:hover {
    transform: translateY(-2px);
    border-color: rgb(185 200 172 / 45%);
    background: rgb(245 242 233 / 7%);
  }

  .timeline-card__heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .timeline-company {
    margin: 0;
    color: #b9c8ac;
    font: 0.76rem/1.4 monospace;
    letter-spacing: 0.06em;
  }

  .timeline-card h3 {
    margin: 0.45rem 0 0;
    color: var(--snow);
    font-size: 1.25rem;
  }

  .timeline-period {
    margin: 0.2rem 0 0;
    color: #aeb8aa;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .achievement-list {
    display: grid;
    gap: 0.65rem;
    margin: 1.2rem 0 0;
    padding: 0 1.2rem 0 0;
    color: #d3d8ce;
    font-size: 0.88rem;
    line-height: 1.85;
  }

  .achievement-list li::marker {
    color: #b9c8ac;
  }

  .toolkit-section {
    padding-bottom: clamp(5rem, 9vw, 8.5rem);
  }

  .toolkit-section .section-heading {
    margin-bottom: 3rem;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .skill-card {
    position: relative;
    min-height: 220px;
    padding: 1.55rem;
    border: 1px solid rgb(52 76 67 / 17%);
    background: rgb(245 242 233 / 42%);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      background-color 220ms ease;
  }

  .skill-card:hover {
    transform: translateY(-5px);
    background: var(--snow);
    box-shadow: 0 20px 36px rgb(20 37 31 / 10%);
  }

  .skill-number {
    color: #778a73;
    font: 0.7rem/1 monospace;
  }

  .skill-card h3 {
    margin: 1.4rem 0 0;
    color: var(--forest);
    font-size: 1.15rem;
  }

  .skill-card p {
    max-width: 21rem;
    margin: 0.85rem 0 0;
    color: #56665c;
    font-size: 0.86rem;
    line-height: 1.8;
    text-align: start;
  }

  .skill-card__arrow {
    position: absolute;
    bottom: 1.25rem;
    left: 1.35rem;
    color: #6d8068;
    font-size: 1.1rem;
  }

  .project-section {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 18% 52%, rgb(79 105 85 / 23%), transparent 38%), var(--forest);
  }

  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 8vw, 8rem);
  }

  .project-copy .display-title {
    margin-top: 1.4rem;
  }

  .project-name {
    margin: 1.4rem 0 0;
    color: #d4dfca;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .body-copy--light {
    color: #c2cbbf;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .project-tags span {
    padding: 0.45rem 0.6rem;
    border: 1px solid rgb(217 212 199 / 20%);
    color: #d4dfca;
    font: 0.65rem/1 monospace;
  }

  .project-art {
    position: relative;
    display: grid;
    width: min(100%, 390px);
    aspect-ratio: 1;
    place-items: center;
    justify-self: center;
  }

  .project-art__orbit {
    position: absolute;
    border: 1px solid rgb(185 200 172 / 28%);
    border-radius: 50%;
  }

  .project-art__orbit--outer {
    inset: 4%;
    transform: rotate(-25deg) scaleY(0.62);
  }

  .project-art__orbit--inner {
    inset: 16%;
    transform: rotate(38deg) scaleY(0.8);
  }

  .project-node {
    position: absolute;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid rgb(197 211 183 / 52%);
    border-radius: 50%;
    background: #253b31;
    color: #dce5d2;
    font: 0.7rem/1 monospace;
  }

  .project-node--center {
    width: 5.5rem;
    height: 5.5rem;
    background: #a9bb99;
    color: var(--forest);
    font-size: 1.2rem;
    box-shadow: 0 0 55px rgb(185 200 172 / 18%);
  }

  .project-node--one {
    top: 13%;
    right: 24%;
  }

  .project-node--two {
    bottom: 20%;
    right: 8%;
  }

  .project-node--three {
    bottom: 12%;
    left: 20%;
  }

  .project-art__caption {
    position: absolute;
    bottom: 2%;
    color: #aeb8aa;
    font: 0.57rem/1 monospace;
    letter-spacing: 0.18em;
  }

  .closing-photo {
    position: relative;
    display: grid;
    min-height: clamp(260px, 42vw, 510px);
    overflow: hidden;
    place-items: center;
    background: var(--forest);
    color: var(--snow);
  }

  .closing-photo__image {
    opacity: 0.75;
    object-position: center 54%;
  }

  .closing-photo__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(20 37 31 / 57%), rgb(20 37 31 / 5%));
  }

  .closing-photo p {
    z-index: 1;
    margin: 0;
    padding: 1rem;
    color: var(--snow);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.4rem, 6vw, 5rem);
    text-align: center;
  }

  .closing-section > .section-shell {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .foundation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .foundation-card {
    padding: 1.5rem;
    border-top: 1px solid #aeb7a8;
    background: #eeece2;
  }

  .foundation-card h3 {
    margin: 1rem 0 0;
    color: var(--forest);
    font-size: 1.2rem;
  }

  .foundation-card > p:last-child {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.85;
  }

  .about-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: 2rem;
    border-top: 1px solid #c8c8bc;
  }

  .about-contact h2 {
    margin: 0.55rem 0 0;
    color: var(--forest);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
  }

  .contact-actions {
    margin-top: 0;
  }

  .button--forest {
    background: var(--forest);
    color: var(--snow);
  }

  .button--forest:hover {
    background: var(--pine);
  }

  .button--line {
    border-color: #aab4a6;
    color: var(--forest);
  }

  .button--line:hover {
    border-color: var(--forest);
    background: #e9e9df;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }

  .js .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 650ms ease,
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .js .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.4;
      transform: scaleX(0.65);
      transform-origin: right;
    }

    50% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes mh-drift {
    from {
      transform: translate3d(-2.2%, 0, 0);
    }

    to {
      transform: translate3d(2.2%, 0, 0);
    }
  }

  @keyframes mh-mist {
    from {
      transform: translate3d(-7%, 0, 0);
    }

    to {
      transform: translate3d(7%, 0, 0);
    }
  }

  @media (max-width: 900px) {
    .about-rail {
      top: auto;
      right: 50%;
      bottom: 0.7rem;
      left: auto;
      width: min(calc(100vw - 1.25rem), 32rem);
      flex-direction: row;
      justify-content: center;
      gap: 0.25rem;
      padding: 0.45rem;
      border: 1px solid rgb(245 242 233 / 25%);
      border-radius: 999px;
      background: rgb(20 37 31 / 90%);
      color: var(--snow);
      mix-blend-mode: normal;
      transform: translateX(50%);
      backdrop-filter: blur(12px);
    }

    .about-rail__links {
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
      gap: 0.1rem;
    }

    .about-rail__link {
      min-width: 2.5rem;
      justify-content: center;
      padding: 0.12rem;
    }

    .about-rail__number {
      width: 1.7rem;
      height: 1.7rem;
    }

    .about-rail__label {
      display: none;
    }

    .story-grid,
    .project-grid {
      grid-template-columns: 1fr 0.9fr;
      gap: 2.5rem;
    }

    .photo-frame {
      min-height: 370px;
    }

    .photo-image {
      height: 420px;
    }
  }

  @media (max-width: 700px) {
    .mountain-horizon {
      --parallax-range: 34px;
      height: clamp(260px, 72vw, 360px);
    }

    .mountain-horizon__caption {
      bottom: 0.75rem;
      font-size: 0.48rem;
    }

    .about-hero {
      min-height: min(790px, calc(100svh - 108px));
      min-height: max(610px, calc(100svh - 108px));
      align-items: end;
    }

    .about-hero__image {
      object-position: 57% center;
    }

    .about-hero__shade {
      background:
        linear-gradient(
          0deg,
          rgb(15 29 24 / 92%) 0%,
          rgb(15 29 24 / 68%) 48%,
          rgb(15 29 24 / 8%) 100%
        ),
        linear-gradient(270deg, rgb(15 29 24 / 20%), transparent);
    }

    .about-hero__content {
      width: min(100% - 2rem, 38rem);
      padding: 0 0 6.5rem;
    }

    .about-hero h1 {
      margin-top: 1.1rem;
      font-size: clamp(4.1rem, 20vw, 6.6rem);
    }

    .about-hero__role {
      margin-top: 1rem;
      font-size: 1.15rem;
    }

    .about-hero__intro {
      max-width: 34rem;
      font-size: 0.92rem;
      line-height: 1.85;
    }

    .about-hero__caption {
      right: 1rem;
      bottom: 4.55rem;
      left: 1rem;
      font-size: 0.5rem;
    }

    .scroll-cue {
      right: 1rem;
      bottom: 1.45rem;
      flex-direction: row-reverse;
      transform: none;
    }

    .section-shell {
      width: min(100% - 2rem, 38rem);
    }

    .story-grid,
    .project-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .story-photo {
      grid-row: 1;
    }

    .photo-frame {
      min-height: 300px;
    }

    .photo-image {
      height: 350px;
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2.5rem;
    }

    .section-aside {
      max-width: 26rem;
    }

    .timeline {
      gap: 1rem;
    }

    .timeline::before {
      right: 1rem;
    }

    .timeline-item {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.8rem;
    }

    .timeline-marker {
      width: 2rem;
      height: 2rem;
      font-size: 0.55rem;
    }

    .timeline-card {
      padding: 1rem;
    }

    .timeline-card__heading {
      flex-direction: column;
      gap: 0.45rem;
    }

    .timeline-period {
      font-size: 0.74rem;
    }

    .achievement-list {
      gap: 0.6rem;
      padding-right: 1rem;
      font-size: 0.83rem;
    }

    .skill-grid,
    .foundation-grid {
      grid-template-columns: 1fr;
    }

    .skill-card {
      min-height: 185px;
    }

    .project-art {
      width: min(76vw, 340px);
      grid-row: 1;
    }

    .closing-photo {
      min-height: 300px;
    }

    .about-contact {
      align-items: start;
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (max-width: 380px) {
    .about-hero__actions {
      gap: 0.45rem;
    }

    .button {
      min-height: 2.7rem;
      gap: 0.5rem;
      padding-inline: 0.8rem;
      font-size: 0.8rem;
    }

    .about-rail {
      width: calc(100vw - 1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    .js .reveal {
      opacity: 1;
      transform: none;
    }

    .js .ridge,
    .js .mist {
      opacity: 1;
      translate: none;
    }

    .ridge {
      transform: none;
      will-change: auto;
    }

    .ridge__svg,
    .mist {
      animation: none !important;
    }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>('.alpine-page');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-about-section]')];
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];
  const heroImage = document.querySelector<HTMLElement>('.about-hero__image');
  const mountainHorizon = document.querySelector<HTMLElement>('[data-mountain-horizon]');
  let horizonInView = false;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.documentElement.classList.add('js');

  const updateScrollEffects = () => {
    const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = scrollableHeight > 0 ? window.scrollY / scrollableHeight : 0;
    page?.style.setProperty('--about-progress', String(Math.min(1, Math.max(0, progress))));

    if (!reducedMotion && heroImage) {
      const shift = Math.min(window.scrollY * 0.12, 72);
      heroImage.style.setProperty('--hero-parallax', `${shift}px`);
    }

    if (!reducedMotion && mountainHorizon && horizonInView) {
      // -1 when the skyline enters from below, +1 when it leaves at the top.
      const bounds = mountainHorizon.getBoundingClientRect();
      const raw = (window.innerHeight - bounds.top) / (window.innerHeight + bounds.height);
      const p = Math.min(1, Math.max(0, raw)) * 2 - 1;
      mountainHorizon.style.setProperty('--p', p.toFixed(3));
    }
  };

  let scrollTicking = false;
  const onScroll = () => {
    if (scrollTicking) return;
    scrollTicking = true;
    requestAnimationFrame(() => {
      scrollTicking = false;
      updateScrollEffects();
    });
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', updateScrollEffects);
  updateScrollEffects();

  if ('IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12 },
    );
    document.querySelectorAll('.reveal').forEach((item) => revealObserver.observe(item));

    if (mountainHorizon) {
      new IntersectionObserver(
        ([entry]) => {
          horizonInView = entry.isIntersecting;
          mountainHorizon.classList.toggle('is-inview', horizonInView);
          if (entry.intersectionRatio >= 0.15) mountainHorizon.classList.add('is-visible');
          updateScrollEffects();
        },
        { threshold: [0, 0.15] },
      ).observe(mountainHorizon);
    }

    const sectionObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;

        const sectionId = (visible.target as HTMLElement).dataset.aboutSection;
        navLinks.forEach((link) => {
          if (link.dataset.sectionLink === sectionId) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.2, 0.5, 0.8] },
    );
    sections.forEach((section) => sectionObserver.observe(section));
  } else {
    horizonInView = true;
    document
      .querySelectorAll('.reveal, [data-mountain-horizon]')
      .forEach((item) => item.classList.add('is-visible'));
  }
</script>
