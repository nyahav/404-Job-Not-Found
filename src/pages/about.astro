---
import JsonLd from '../components/site/JsonLd.astro';
import AscentAbout from '../components/site/AscentAbout.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const description =
  'הכירו את יהב ניר, מהנדס תוכנה המתמחה במערכות מבוזרות, שירותי Backend ואמינות מערכות.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'אודות | יהב ניר',
  url: new URL('about/', new URL(import.meta.env.BASE_URL, Astro.site)).toString(),
  mainEntity: {
    '@type': 'Person',
    name: 'יהב ניר',
    jobTitle: 'מהנדס תוכנה',
    description,
    email: 'mailto:yahavnirr@gmail.com',
    sameAs: ['https://www.linkedin.com/in/nir-yahav/', 'https://github.com/nyahav'],
  },
};
---

<SiteLayout
  title="אודות | יהב ניר"
  description={description}
  lang="he"
  dir="rtl"
  wide
  theme="alpine"
>
  <Fragment slot="head">
    <JsonLd data={structuredData} />
  </Fragment>
  <AscentAbout />
</SiteLayout>
