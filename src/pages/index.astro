---
import { getCollection } from 'astro:content';
import ArticleBento from '../components/site/ArticleBento';
import FeatureBento from '../components/site/FeatureBento';
import HomeHero from '../components/site/HomeHero';
import SiteLayout from '../layouts/SiteLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((first, second) => second.data.pubDate.valueOf() - first.data.pubDate.valueOf())
  .map((article) => ({
    slug: article.id.replace(/\.(md|mdx)$/, ''),
    title: article.data.title,
    description: article.data.description,
    pubDate: article.data.pubDate.toISOString(),
  }));
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<SiteLayout
  title="404 - Job Not Found"
  description="Articles and interactive demos exploring software and the web."
  wide
>
  <div class="home-page">
    <HomeHero basePath={basePath} client:load />

    <section aria-labelledby="projects-title" class="features-section" id="projects">
      <div class="section-intro">
        <div>
          <p class="eyebrow-token">Explore / 01—03</p>
          <h2 id="projects-title">Built to be explored.</h2>
        </div>
      </div>
      <FeatureBento basePath={basePath} client:visible />
    </section>

    <section aria-labelledby="articles-title" class="articles-section" id="articles">
      <div class="section-intro">
        <div>
          <p class="eyebrow-token">The notebook / 01—03</p>
          <h2 id="articles-title">Articles</h2>
        </div>
        <a class="articles-section__link" href={`${basePath}articles/`}>
          All articles
        </a>
      </div>
      <ArticleBento articles={articles} basePath={basePath} client:visible />
    </section>
  </div>
</SiteLayout>
