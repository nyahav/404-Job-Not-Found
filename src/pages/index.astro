---
import { getCollection } from 'astro:content';
import FeatureBento from '../components/site/FeatureBento';
import HomeHero from '../components/site/HomeHero';
import SiteLayout from '../layouts/SiteLayout.astro';

const articles = (await getCollection('articles')).sort(
  (first, second) => second.data.pubDate.valueOf() - first.data.pubDate.valueOf(),
);
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<SiteLayout
  title="404 - Job Not Found"
  description="Articles and interactive demos exploring software and the web."
  wide
>
  <div class="home-page">
    <HomeHero basePath={basePath} client:load />

    <section aria-labelledby="projects-title" class="features-section" id="projects">
      <div class="section-intro">
        <div>
          <p class="eyebrow-token">Explore / 01—03</p>
          <h2 id="projects-title">Built to be explored.</h2>
        </div>
      </div>
      <FeatureBento basePath={basePath} client:visible />
    </section>

    <section aria-labelledby="articles-title" class="articles-section" id="articles">
      <div class="section-intro">
        <div>
          <p class="eyebrow-token">The notebook</p>
          <h2 id="articles-title">Articles</h2>
        </div>
      </div>
      {articles.length > 0 ? (
        <div class="article-grid">
          {articles.map((article) => (
            <a
              class="article-card"
              href={`${basePath}articles/${article.id.replace(/\.(md|mdx)$/, '')}/`}
            >
              <time datetime={article.data.pubDate.toISOString()}>
                {article.data.pubDate.toLocaleDateString('en', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-muted">
          No articles yet. Add an MDX file to <code>src/content/articles/</code>.
        </p>
      )}
    </section>
  </div>
</SiteLayout>
